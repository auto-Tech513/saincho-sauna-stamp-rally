{
  "id": "./",
  "name": "サ印帳",
  "short_name": "サ印帳",
  "description": "サウナを検索して行った施設をサ印として記録できる無料のサウナスタンプラリー・サ活記録アプリ。サウナ版御朱印、サ飯、称号、ランキング対応。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#fbfbf7",
  "theme_color": "#101417",
  "categories": ["lifestyle", "travel", "health"],
  "shortcuts": [
    {
      "name": "サウナを探す",
      "short_name": "探す",
      "url": "./",
      "description": "サウナ名、都道府県、特徴で候補を探す"
    },
    {
      "name": "サウナ入門",
      "short_name": "入門",
      "url": "./guide/",
      "description": "入り方、持ち物、マナーを確認する"
    },
    {
      "name": "サ飯を探す",
      "short_name": "サ飯",
      "url": "./sameshi/",
      "description": "県別の人気サ飯を探す"
    },
    {
      "name": "サウナ合宿先を探す",
      "short_name": "合宿",
      "url": "./stay/",
      "description": "Airbnbなどのサウナ付き宿を探す"
    },
    {
      "name": "掲載・お問い合わせ",
      "short_name": "掲載",
      "url": "./contact/",
      "description": "広告掲載、プレミアム個別ページ、内容修正を相談する"
    },
    {
      "name": "Gear",
      "short_name": "Gear",
      "url": "./gear/",
      "description": "サウナグッズを比較する"
    },
    {
      "name": "ランキング",
      "short_name": "順位",
      "url": "./ranking/",
      "description": "サ印ランキングを確認する"
    }
  ],
